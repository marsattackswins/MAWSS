{
  "name": "maws",
  "version": "0.1.0",
  "private": true,
  "description": "MAWS — Market Analysis & Workflow System",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:restart": "node scripts/dev.mjs --restart",
    "dev:throwaway": "node scripts/dev.mjs --throwaway",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/supervisor.mjs",
    "start:bare": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "test": "jest",
    "test:charting": "vitest run --root lib/charting",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:verbose": "MAWS_TEST_VERBOSE=true npm run test:integration",
    "test:integration:setup": "node scripts/check-integration-setup.mjs",
    "journal": "pnpm -C vendor/trade-journal/apps/web exec next start -p 3400",
    "journal:build": "pnpm -C vendor/trade-journal/apps/web exec next build",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:live:dry": "tsx scripts/smoke-live.ts --dry-run",
    "smoke:testnet": "tsx scripts/testnet-smoke.ts",
    "verify:testnet": "tsx scripts/verify-testnet.ts",
    "secret-scan": "node scripts/secret-scan.mjs",
    "gen-operator-auth": "node scripts/gen-operator-auth.mjs",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@luxalgo/vela": "^0.8.3",
    "@luxalgo/vela-pinets": "^0.2.15",
    "@zag-js/core": "^1.42.0",
    "@zag-js/dialog": "^1.42.0",
    "@zag-js/dom-query": "^1.42.0",
    "@zag-js/menu": "^1.42.0",
    "@zag-js/tooltip": "^1.42.0",
    "@zag-js/types": "^1.42.0",
    "@zag-js/vanilla": "^1.42.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jest": "^30.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
